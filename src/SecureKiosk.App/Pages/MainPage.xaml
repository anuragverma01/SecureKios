<Page x:Class="SecureKiosk.App.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0B1220" Padding="48">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
            <TextBlock Text="Managed by Anurag" Foreground="White" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="This system is in lockdown." Foreground="#94A3B8" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="You can’t break it." Foreground="#F1F5F9" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Think you can break it?" Foreground="#94A3B8" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Go ahead. Try." Foreground="#38BDF8" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <ProgressRing IsActive="{Binding IsBusy}" Visibility="{Binding BusyVisibility}" Width="32" Height="32" HorizontalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Administrator exit" Command="{Binding ShowExitCommand}" HorizontalAlignment="Right" Padding="18,10"/>
    </Grid>
</Page>
