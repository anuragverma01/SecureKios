<Page x:Class="SecureKiosk.App.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0B1220" Padding="48">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
            <TextBlock Text="SecureKiosk" Foreground="White" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="This device is securely managed." Foreground="#B9C7DA" FontSize="20" HorizontalAlignment="Center"/>
            <ProgressRing IsActive="{Binding IsBusy}" Visibility="{Binding BusyVisibility}" Width="32" Height="32"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Administrator exit" Command="{Binding ShowExitCommand}" HorizontalAlignment="Right" Padding="18,10"/>
    </Grid>
</Page>
